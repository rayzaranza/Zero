#==============================================================================
# Set default behavior to automatically normalize line endings,
# but only for files Git detects as text. This is the safe form —
# "eol=lf" without "text=auto" forces ALL files to be treated as text,
# which can corrupt binaries.
#==============================================================================
* text=auto eol=lf

#==============================================================================
# Explicitly declare binary files, as defense-in-depth against Git's
# own text/binary auto-detection getting it wrong.
#==============================================================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.tga binary
*.dds binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary

